<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.makeevrserg.compose.html.preview</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Compose HTML Preview</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="makeevrserg@gmail.com" url="https://github.com/makeevrserg">makeevrserg</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        Preview Compose HTML (DOM) composables right inside the IDE.
        <ul>
            <li>Adds a gutter icon to top-level <code>@Preview @Composable</code> functions.</li>
            <li>Finds the Kotlin/JS or Kobweb module that serves the previews from the Gradle structure of the
                project, no settings required.</li>
            <li>Starts its dev server when it is not running and learns the port from the server output.</li>
            <li>Renders the previews of the current file in a tool window powered by the embedded browser (JCEF).</li>
            <li>Live reload of the dev server keeps the preview in sync with your code.</li>
        </ul>
        The project provides a preview page that reads the <code>preview</code> query parameter and renders the
        matching composables.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.gradle</depends>

    <!-- Only PSI is used, no resolve, so both K1 and K2 modes of the Kotlin plugin are supported. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <runLineMarkerContributor
                language="kotlin"
                implementationClass="com.makeevrserg.compose.html.preview.linemarker.PreviewRunLineMarkerContributor"/>

        <toolWindow
                id="Compose HTML Preview"
                anchor="right"
                doNotActivateOnStart="true"
                icon="/icons/toolWindowPreview.svg"
                factoryClass="com.makeevrserg.compose.html.preview.ui.PreviewToolWindowFactory"/>

        <notificationGroup id="Compose HTML Preview" displayType="BALLOON"/>

        <postStartupActivity implementation="com.makeevrserg.compose.html.preview.startup.PreviewStartupActivity"/>
    </extensions>
</idea-plugin>
